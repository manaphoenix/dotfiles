# Cross-machine Git configuration (safe for public dotfiles)
#
# Machine-specific / private settings (user.name, user.email, credentials,
# platform tweaks such as core.autocrlf) go in ~/.gitconfig.local, which is
# included automatically below and is not tracked.

[include]
    path = ~/.gitconfig.local

[filter "lfs"]
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f

[color]
    ui = auto

[core]
    excludesfile = ~/.gitignore_global

[pull]
    rebase = true

[fetch]
    prune = true

[alias]
    st = status
    co = checkout
    br = branch
    lg = log --oneline --graph --decorate

[diff]
    tool = code

[difftool "code"]
    cmd = code --wait --diff "$LOCAL" "$REMOTE"

[rebase]
    autoStash = true

[commit]
    verbose = true
