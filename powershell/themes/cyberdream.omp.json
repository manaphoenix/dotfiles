{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "black": "#16181a",
    "red": "#ff6e5e",
    "green": "#4bd37f",
    "yellow": "#f1ff87",
    "blue": "#5ea1ff",
    "magenta": "#bd5eff",
    "cyan": "#5ef1ff",
    "white": "#e0e0e0",
    "bright_black": "#3c4048",
    "bright_red": "#ff6e5e",
    "bright_green": "#4bd37f",
    "bright_yellow": "#f1ff87",
    "bright_blue": "#5ea1ff",
    "bright_magenta": "#bd5eff",
    "bright_cyan": "#5ef1ff",
    "bright_white": "#ffffff",
    "text": "#e0e0e0"
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "p:blue",
          "foreground": "p:text",
          "style": "powerline",
          "powerline_symbol": "",
          "template": "  {{ .UserName }}",
          "type": "session"
        },
        {
          "background": "p:green",
          "foreground": "p:black",
          "style": "powerline",
          "properties": {
            "folder_icon": "\uf07b",
            "home_icon": "~",
            "style": "agnoster_short"
          },
          "powerline_symbol": "",
          "template": " {{ .Path }}",
          "type": "path"
        },
        {
          "background": "p:magenta",
          "foreground": "p:black",
          "style": "powerline",
          "properties": {
            "branch_icon": "",
            "display_status": true,
            "fetch_status": true
          },
          "powerline_symbol": "",
          "template": " {{ .HEAD }}",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "type": "rprompt",
      "overflow": "hidden",
      "segments": [
        {
          "background": "transparent",
          "foreground": "p:text",
          "style": "plain",
          "template": "{{ .FormattedMs }}",
          "type": "executiontime",
          "properties": {
            "threshold": 5000
          }
        }
      ]
    }
  ],
  "final_space": true,

  "transient_prompt": {
    "background": "transparent",
    "foreground": "p:bright_blue",
    "template": " "
  },

  "version": 3
}
